# dof-research alley scene, format version 1
# GENERATED by tools/scene/build_alley.py -- regenerate instead of hand-editing
# large edits, but single-line tweaks are fine (press L in the renderer to reload).
#
# Read by src/SceneFile.cpp (OpenGL) and tools/raytraced_reference/render_dof.py
# (Cycles). rgb is LINEAR albedo; emit > 0 means the surface emits rgb * emit
# and is not shaded. 1 unit = 1 meter, +Y up, camera looks down -Z.
version 1
#
# Camera and lens: the values main.cpp starts with and render_dof.py matches.
camera pos 0 0 5 yaw -90 pitch 0 focus 5 fnumber 1.4 lens 50 sensor 24
#
# Dusk key light. energy is irradiance in W/m^2, as Blender's sun strength;
# the raster pass divides by pi to match a Lambert diffuse BSDF.
sun dir -0.45 0.78 0.44 color 1 0.88 0.72 energy 4.2 angle 0.6
# Uniform sky: also the OpenGL clear colour and Cycles' world background.
ambient color 0.42 0.52 0.72 strength 0.24
#
# Region the shadow map has to cover. Without this the frustum would also
# have to contain the distant blocks at z = -47, wasting most of its texels.
shadow lo -7 -2 -34 hi 7 8 9
#
